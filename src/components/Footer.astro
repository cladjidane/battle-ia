<footer>
  <div class="f-left">
    <span class="f-brand">Context Collective</span>
    <span>Communauté IA — Brest, Bretagne</span>
    <span>AI Creation Battle — Édition fondatrice 2026</span>
  </div>
  <nav class="f-nav">
    <a href="/la-battle">La Battle</a>
    <a href="/edition-01">Édition 01</a>
    <a href="/participer">Participer</a>
    <a href="/nous-soutenir">Nous soutenir</a>
    <a href="/faq">FAQ</a>
    <a href="/a-propos">À propos</a>
  </nav>
  <div class="f-right">
    <a href="mailto:contact@koality.fr">contact@koality.fr</a>
    <span>Fabien Canu — Koality</span>
  </div>
</footer>

<style>
footer {
  padding: 36px max(56px, calc(50% - 600px));
  border-top: 1px solid var(--border);
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 40px;
  align-items: center;
}
.f-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-family: var(--font-mono);
  font-size: 9px;
  color: #2e2e2e;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  line-height: 1.8;
}
.f-brand {
  color: var(--yellow);
  font-weight: 700;
}
.f-nav {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.f-nav a {
  font-family: var(--font-mono);
  font-size: 8px;
  color: #333;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  transition: color 0.2s;
}
.f-nav a:hover { color: var(--white); }
.f-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  font-family: var(--font-mono);
  font-size: 9px;
  color: #2e2e2e;
  letter-spacing: 0.1em;
  text-align: right;
  line-height: 1.8;
}
.f-right a { color: var(--yellow); transition: color 0.2s; }
.f-right a:hover { color: var(--white); }

@media (max-width: 768px) {
  footer {
    grid-template-columns: 1fr;
    padding: 36px 24px;
    gap: 28px;
    text-align: center;
  }
  .f-left, .f-right { align-items: center; }
  .f-nav { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 12px 20px; }
}
</style>
