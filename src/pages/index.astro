---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accueil" current="/">

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"><span>BATTLE</span></div>

  <div class="hero-tag">
    <div class="tag-pulse"></div>
    <span>Context Collective — Brest, Bretagne — Édition 01 — Mai 2026</span>
  </div>

  <div class="hero-title">
    <span class="l1">AI</span>
    <span class="l2">CREATION</span>
    <span class="l3">BATTLE</span>
  </div>

  <div class="hero-bottom">
    <p class="hero-desc">
      Une soirée live de 3 heures. Des profils totalement différents.
      <strong>1 heure pour construire un projet avec l'IA, en partant de zéro, avec le même budget de tokens pour tous.</strong>
    </p>
    <div class="hero-stats">
      <div class="hs"><div class="hs-val">3H</div><div class="hs-lbl">Soirée live</div></div>
      <div class="hs"><div class="hs-val">60'</div><div class="hs-lbl">Build chrono</div></div>
      <div class="hs"><div class="hs-val">10</div><div class="hs-lbl">Participants</div></div>
      <div class="hs"><div class="hs-val">01</div><div class="hs-lbl">1ère édition</div></div>
    </div>
  </div>

  <div class="scroll-hint">
    <div class="scroll-line"></div>
    <span>Scroll</span>
  </div>
</section>

<!-- MANIFESTE CONDENSÉ -->
<section class="manifeste-home">
  <div class="s-eyebrow reveal"><span>Pourquoi cet événement</span></div>
  <div class="s-title reveal rd1">L'IA ne se comprend pas<br/>en lisant des articles.</div>

  <p class="lead reveal rd2" style="margin-bottom:24px;">Elle se comprend en la voyant travailler. C'est pour ça qu'on organise la Battle : un événement live, sans filtre, où des gens de profils très différents construisent un projet réel en une heure.</p>

  <p class="reveal rd2" style="max-width:600px;margin-bottom:40px;">On ne cherche pas à impressionner. On cherche à rendre visible ce qui est <strong>déjà vrai.</strong></p>

  <a href="/la-battle" class="btn-ghost reveal rd3">Découvrir le format →</a>

  <div class="mh-entries reveal rd4">
    <a href="/participer" class="mh-entry">
      <span class="mhe-num">01</span>
      <span class="mhe-body">
        <strong>Vous avez une idée</strong>
        Développeur, designer, profil métier, curieux. Vous arrivez avec un projet. Vous repartez avec quelque chose qui existe.
      </span>
      <span class="mhe-arrow">→</span>
    </a>
    <a href="/nous-soutenir" class="mh-entry">
      <span class="mhe-num">02</span>
      <span class="mhe-body">
        <strong>Le projet vous parle</strong>
        Entreprise, collectivité, organisme. Si l'initiative vous intéresse, on est ouverts à la discussion.
      </span>
      <span class="mhe-arrow">→</span>
    </a>
    <a href="/edition-01" class="mh-entry">
      <span class="mhe-num">03</span>
      <span class="mhe-body">
        <strong>Mai 2026 — Brest</strong>
        French Tech Brest. Entrée libre pour les spectateurs. Première édition.
      </span>
      <span class="mhe-arrow">→</span>
    </a>
  </div>
</section>

<!-- CTA HOME -->
<section class="cta-home">
  <div class="ctah-inner reveal">
    <div class="s-title" style="text-align:center;margin-bottom:48px;">Est-ce qu'on regarde,<br/><span class="yel">ou est-ce qu'on s'y met ?</span></div>
    <div class="ctah-actions">
      <a href="/participer" class="btn-main">Je veux participer →</a>
      <span class="or-sep">ou</span>
      <a href="/nous-soutenir" class="btn-ghost">Soutenir le projet</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* HERO */
.hero {
  min-height: 100vh;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 var(--pad-x) 80px;
  position: relative;
  overflow: hidden;
  border-top: none;
}
.hero-bg {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  pointer-events: none; overflow: hidden;
}
.hero-bg span {
  font-family: var(--font-display);
  font-size: 38vw;
  color: transparent;
  -webkit-text-stroke: 1px #151515;
  white-space: nowrap;
  letter-spacing: -0.02em;
  animation: breathe 8s ease-in-out infinite;
  user-select: none;
}
@keyframes breathe {
  0%,100% { transform: scale(1); opacity:0.7; }
  50% { transform: scale(1.015); opacity:1; }
}

.hero-tag {
  display: flex; align-items: center; gap: 14px;
  margin-bottom: 36px;
  opacity: 0; animation: fadeup 0.9s 0.1s forwards;
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  letter-spacing: 0.2em;
  color: var(--yellow);
  text-transform: uppercase;
}
.tag-pulse {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--yellow);
  animation: blink 1.8s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(80px, 13vw, 180px);
  line-height: 0.86;
  margin-bottom: 48px;
  opacity: 0; animation: fadeup 0.9s 0.25s forwards;
}
.hero-title .l1 { display: block; color: var(--text-1); }
.hero-title .l2 { display: block; color: var(--yellow); }
.hero-title .l3 { display: block; -webkit-text-stroke: 2px var(--white); color: transparent; }

.hero-bottom {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: end;
  opacity: 0; animation: fadeup 0.9s 0.45s forwards;
}
.hero-desc {
  max-width: 460px;
}

.hero-stats {
  display: flex; gap: 40px; justify-content: flex-end;
}
.hs { text-align: center; }
.hs-val {
  font-family: var(--font-display);
  font-size: 48px;
  color: var(--yellow);
  line-height: 1;
}
.hs-lbl {
  font-family: var(--font-mono);
  font-size: var(--text-mono-sm);
  color: var(--text-3);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-top: 8px;
}

.scroll-hint {
  position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 10px;
  opacity: 0; animation: fadeup 0.9s 1.1s forwards;
  font-family: var(--font-mono);
  font-size: 9px; color: var(--text-3);
  letter-spacing: 0.18em; text-transform: uppercase;
}
.scroll-line {
  width: 1px; height: 44px;
  background: linear-gradient(to bottom, var(--yellow), transparent);
  animation: drip 1.8s ease-in-out infinite;
}
@keyframes drip {
  0%{ transform:scaleY(0); transform-origin:top; }
  50%{ transform:scaleY(1); transform-origin:top; }
  51%{ transform:scaleY(1); transform-origin:bottom; }
  100%{ transform:scaleY(0); transform-origin:bottom; }
}
@keyframes fadeup {
  from { opacity:0; transform:translateY(24px); }
  to   { opacity:1; transform:translateY(0); }
}

/* MANIFESTE HOME */
.manifeste-home { background: var(--dark); }

.mh-entries {
  display: flex; flex-direction: column;
  margin-top: 72px;
}
.mh-entry {
  display: grid;
  grid-template-columns: 56px 1fr 32px;
  gap: 24px;
  align-items: center;
  padding: 32px 0;
  border-top: 1px solid var(--border2);
  transition: padding-left 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}
.mh-entry:last-child { border-bottom: 1px solid var(--border2); }
.mh-entry:hover { padding-left: 12px; }
.mhe-num {
  font-family: var(--font-display);
  font-size: 40px;
  color: var(--border2);
  line-height: 1;
  transition: color 0.3s;
}
.mh-entry:hover .mhe-num { color: var(--yellow); }
.mhe-body { display: flex; flex-direction: column; gap: 4px; }
.mhe-body strong {
  font-size: var(--text-body);
  font-weight: 600;
  letter-spacing: 0.02em;
}
.mhe-arrow {
  font-family: var(--font-mono);
  font-size: 16px;
  color: var(--border2);
  justify-self: end;
  transition: color 0.3s, transform 0.3s;
}
.mh-entry:hover .mhe-arrow { color: var(--yellow); transform: translateX(4px); }

/* CTA HOME */
.cta-home {
  background: var(--black);
  padding: 160px var(--pad-x);
  text-align: center;
}
.ctah-actions {
  display: flex; align-items: center; justify-content: center;
  gap: 20px; flex-wrap: wrap;
}

@media (max-width: 768px) {
  .hero { padding: 0 24px 64px !important; }
  .hero-title { font-size: clamp(56px, 16vw, 120px); }
  .hero-bottom { grid-template-columns: 1fr; gap: 32px; }
  .hero-stats { justify-content: flex-start; gap: 28px; flex-wrap: wrap; }
  .mh-entry { grid-template-columns: 44px 1fr 24px; gap: 16px; padding: 24px 0; }
  .mhe-num { font-size: 32px; }
  .cta-home { padding: 80px 24px !important; }
  .ctah-actions { flex-direction: column; align-items: stretch; }
  .btn-main, .btn-ghost { justify-content: center; }
}
</style>
