---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accueil" current="/">

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"><span>BATTLE</span></div>

  <div class="hero-tag">
    <div class="tag-pulse"></div>
    <span>Context Collective — Brest, Bretagne — Édition 01 — Mai 2026</span>
  </div>

  <div class="hero-title">
    <span class="l1">AI</span>
    <span class="l2">CREATION</span>
    <span class="l3">BATTLE</span>
  </div>

  <div class="hero-bottom">
    <p class="hero-desc">
      Une soirée live de 3 heures. Des profils totalement différents.<br/>
      <strong>1 heure pour construire un projet avec l'IA, en partant de zéro, avec le même budget de tokens pour tous.</strong>
    </p>
    <div class="hero-stats">
      <div class="hs"><div class="hs-val">3H</div><div class="hs-lbl">Soirée live</div></div>
      <div class="hs"><div class="hs-val">60'</div><div class="hs-lbl">Build chrono</div></div>
      <div class="hs"><div class="hs-val">10</div><div class="hs-lbl">Participants</div></div>
      <div class="hs"><div class="hs-val">01</div><div class="hs-lbl">1ère édition</div></div>
    </div>
  </div>

  <div class="scroll-hint">
    <div class="scroll-line"></div>
    <span>Scroll</span>
  </div>
</section>

<!-- MANIFESTE CONDENSÉ -->
<section class="manifeste-home">
  <div class="s-eyebrow reveal"><span>Pourquoi cet événement</span></div>
  <div class="s-title reveal rd1">L'IA ne se comprend pas<br/>en lisant des articles.</div>

  <div class="mh-grid">
    <div class="mh-intro reveal rd2">
      <p>Elle se comprend en la voyant travailler. C'est pour ça qu'on organise la Battle : un événement live, sans filtre, où des gens de profils très différents construisent un projet réel en une heure, avec les mêmes outils, le même budget, devant tout le monde.</p>
      <p>On ne cherche pas à impressionner. On cherche à rendre visible ce qui est <strong>déjà vrai.</strong></p>
      <a href="/la-battle" class="btn-ghost" style="margin-top:28px;">Découvrir le format →</a>
    </div>

    <div class="mh-blocks">
      <a href="/participer" class="mh-block reveal rd2">
        <div class="mhb-num">01</div>
        <div class="mhb-title">Vous avez une idée</div>
        <div class="mhb-text">Développeur, designer, profil métier, curieux — vous arrivez avec un projet. Vous repartez avec quelque chose qui existe.</div>
        <div class="mhb-cta">Participer →</div>
      </a>
      <a href="/nous-soutenir" class="mh-block reveal rd3">
        <div class="mhb-num">02</div>
        <div class="mhb-title">Le projet vous parle</div>
        <div class="mhb-text">Entreprise, collectivité, organisme — si l'initiative vous intéresse, on est ouverts à la discussion.</div>
        <div class="mhb-cta">Nous soutenir →</div>
      </a>
      <a href="/edition-01" class="mh-block reveal rd4">
        <div class="mhb-num">03</div>
        <div class="mhb-title">Mai 2026 — Brest</div>
        <div class="mhb-text">French Tech Brest. Entrée libre pour les spectateurs. Première édition.</div>
        <div class="mhb-cta">L'édition 01 →</div>
      </a>
    </div>
  </div>
</section>

<!-- CTA HOME -->
<section class="cta-home">
  <div class="ctah-inner reveal">
    <div class="ctah-title">Est-ce qu'on regarde,<br/><span>ou est-ce qu'on s'y met ?</span></div>
    <div class="ctah-actions">
      <a href="/participer" class="btn-main">Je veux participer →</a>
      <span class="or-sep">ou</span>
      <a href="/nous-soutenir" class="btn-ghost">Soutenir le projet</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* HERO */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 max(56px, calc(50% - 600px)) 80px;
  position: relative;
  overflow: hidden;
  border-top: none;
}
.hero-bg {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  overflow: hidden;
}
.hero-bg span {
  font-family: var(--font-display);
  font-size: 38vw;
  color: transparent;
  -webkit-text-stroke: 1px #151515;
  white-space: nowrap;
  letter-spacing: -0.02em;
  animation: breathe 8s ease-in-out infinite;
  user-select: none;
}
@keyframes breathe {
  0%,100% { transform: scale(1); opacity:0.7; }
  50% { transform: scale(1.015); opacity:1; }
}

.hero-tag {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 36px;
  opacity: 0;
  animation: fadeup 0.9s 0.1s forwards;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--yellow);
  text-transform: uppercase;
}
.tag-pulse {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--yellow);
  animation: blink 1.8s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(80px, 12vw, 160px);
  line-height: 0.86;
  margin-bottom: 48px;
  opacity: 0;
  animation: fadeup 0.9s 0.25s forwards;
}
.hero-title .l1 { display: block; }
.hero-title .l2 { display: block; color: var(--yellow); }
.hero-title .l3 { display: block; -webkit-text-stroke: 1.5px var(--white); color: transparent; }

.hero-bottom {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: end;
  opacity: 0;
  animation: fadeup 0.9s 0.45s forwards;
}
.hero-desc {
  font-size: 16px;
  font-weight: 300;
  color: #888;
  line-height: 1.75;
  max-width: 420px;
}
.hero-desc strong { color: var(--white); font-weight: 500; }

.hero-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--border2);
}
.hs {
  padding: 20px 14px;
  border-right: 1px solid var(--border2);
  text-align: center;
}
.hs:last-child { border-right: none; }
.hs-val {
  font-family: var(--font-display);
  font-size: 42px;
  color: var(--yellow);
  line-height: 1;
}
.hs-lbl {
  font-family: var(--font-mono);
  font-size: 8px;
  color: var(--grey);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-top: 5px;
}

.scroll-hint {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  opacity: 0;
  animation: fadeup 0.9s 1.1s forwards;
  font-family: var(--font-mono);
  font-size: 8px;
  color: var(--grey);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.scroll-line {
  width: 1px; height: 44px;
  background: linear-gradient(to bottom, var(--yellow), transparent);
  animation: drip 1.8s ease-in-out infinite;
}
@keyframes drip {
  0%{ transform:scaleY(0); transform-origin:top; }
  50%{ transform:scaleY(1); transform-origin:top; }
  51%{ transform:scaleY(1); transform-origin:bottom; }
  100%{ transform:scaleY(0); transform-origin:bottom; }
}

@keyframes fadeup {
  from { opacity:0; transform:translateY(24px); }
  to   { opacity:1; transform:translateY(0); }
}

/* MANIFESTE HOME */
.manifeste-home { background: var(--dark); }

.mh-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 72px;
  align-items: start;
}
.mh-intro {
  font-size: 15px;
  color: #777;
  line-height: 1.85;
  font-weight: 300;
}
.mh-intro p { margin-bottom: 18px; }
.mh-intro strong { color: #bbb; font-weight: 500; }

.mh-blocks {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.mh-block {
  display: block;
  border: 1px solid var(--border2);
  background: var(--card);
  padding: 24px 28px;
  transition: border-color 0.25s, background 0.25s;
  position: relative;
}
.mh-block:hover { border-color: var(--yellow); background: #181818; }
.mhb-num {
  font-family: var(--font-display);
  font-size: 36px;
  color: var(--border2);
  line-height: 1;
  margin-bottom: 10px;
  transition: color 0.25s;
}
.mh-block:hover .mhb-num { color: var(--yellow); }
.mhb-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--white);
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.mhb-text {
  font-size: 12px;
  color: #666;
  line-height: 1.6;
  font-weight: 300;
}
.mhb-cta {
  margin-top: 14px;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--yellow);
}

/* CTA HOME */
.cta-home {
  background: var(--black);
  padding: 120px max(56px, calc(50% - 600px));
  text-align: center;
}
.ctah-inner {}
.ctah-title {
  font-family: var(--font-display);
  font-size: clamp(48px, 7vw, 96px);
  line-height: 0.9;
  margin-bottom: 48px;
  letter-spacing: 0.01em;
}
.ctah-title span { color: var(--yellow); }
.ctah-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

@media (max-width: 768px) {
  .hero { padding: 0 24px 72px !important; }
  .hero-bottom { grid-template-columns: 1fr; gap: 32px; }
  .hero-stats { grid-template-columns: repeat(2,1fr); }
  .mh-grid { grid-template-columns: 1fr; gap: 48px; }
  .cta-home { padding: 72px 24px !important; }
  .ctah-actions { flex-direction: column; align-items: stretch; }
  .btn-main, .btn-ghost { justify-content: center; }
}
</style>
