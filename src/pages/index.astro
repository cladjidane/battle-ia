---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accueil" current="/">

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"><span>BATTLE</span></div>
  <div class="hero-logo" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 150 150"><path d="M141.14,99.54c.05-.06.11-.11.16-.17l-.33-.13-.17-.29-40.22-16.46c-.24,0-.45.03-.66.09l-.07-.03-.23.15c-.46.19-.88.46-1.32.68-6,3-12.7,8.17-18.86,12.27l-4.46,2.86c-.36.2-.72.35-1.04.37l16.21-26.09-17.12-41.08-17.08,41.12,16.34,25.91h-.12s-25.5-16.46-25.5-16.46c-12.51,5.13-25.15,10.05-37.57,15.4-.87.37-1.99.74-2.88,1.27l-1.06.44.16.27c-.05.06-.11.11-.16.17l.33.13.17.29,40.22,16.46c.24,0,.45-.03.66-.09l.07.03.23-.15c.46-.19.88-.46,1.32-.68,5.99-3,12.69-8.17,18.85-12.26l4.47-2.87c.36-.2.72-.35,1.04-.37l-16.21,26.09,17.12,41.08,17.08-41.12-16.34-25.91h.12s25.5,16.46,25.5,16.46c12.51-5.13,25.15-10.05,37.57-15.4.87-.37,1.99-.74,2.88-1.27l1.06-.44-.16-.27Z" transform="translate(-5, -25)" fill="currentColor"/></svg>
  </div>
  <div class="hero-hermine" aria-hidden="true">
    <svg viewBox="0 0 547.31 288.74" fill="currentColor"><path d="M153.56,288.74l-16.03-51.8,22.45-27.06-3.22-18.28c-2.13-.56-1.53.5-2.1,1.16-7.8,9.09-17.42,23.95-26.39,31.29-15.9,13.01-42.44,22.8-60.03,34.38-18.03-.11-36.22.47-53.99.02-4.74-.12-9.51.17-14.25.03l41.3-55.38,80.59-33.99c7.84-8.37,20.7-14.93,28.45-22.88,11.47-11.75,21.24-33.09,33.04-45.79,3.3-3.56,3.88-3.75,8.44-5.31,22.93-7.82,49.3-11.89,72.67-19l91.73,28.38,25.81-7.11,2.29-2.29,30.25-63.23c2.04-5.69.65-13.07,3.74-18.25,1.49-2.5,18.51-13.6,21.24-13.64,5.71,1.09,12.14,6.25,17.66,7.19,7.25,1.23,16.28-.89,23.4.43,2.82.52,30.97,15.16,33.23,17.18,4.25,3.8,7.68,13.64,12.32,17.93,3.76,3.48,20.75,10.78,21.13,14.64.19,1.9-2.86,12.31-3.99,14.33-.6,1.08-16.29,16.87-17.38,17.45-4.71,2.52-10.36,1.9-15.52,2.82-11.1,1.97-22.26,3.74-33.27,6.14l-23.81,77.01-13.11,15.3-8.42,62.55,18.06,6.71,14.01,29.06h-94.43l-30.68-61.43-50.37-15.4c-1.73.42-10.3,20.08-13.79,23.73-3.1,3.25-22.98,11.24-22.39,14.9l4.15,5.98,19.58.59,17.01,29.76-.98,1.87h-55.92l-35.74-40.99-16.39,5.25c-5.87,3.19,14.79,7.89,15.01,10.53l10.99,25.21h-56.38ZM377.24,276.83h30.71c-1.33-2.26-2.91-5.81-5.02-7.36-3.79-2.79-18.08-5.77-18.82-9.59-.96-4.91,4.16-28.43,5.77-34.56l37.27-117.37,41.51-20.15c12.99-5.43,38.64-3.29,50.19-8.48,2.29-1.03,7.65-7.91,11.02-9.15l-6.39-7.32,8.21-2.75c-.03-1.47-11.51-7.2-13.42-9.02-4.37-4.16-8.12-13.84-12.29-17.49-2.58-2.26-26.66-14.42-29.95-14.97s-6.91-.06-10.32-.21l1.75,5.81-8.51,5.98c-5.91-7.86-8.35-15.85-19.38-17.84-7.96,5.08-12.26,6.05-12.45,16.59-.13,7.54,10.94,19.03,10.08,21.85l-5.86,4.27c-.91-.21-5.83-9.75-7.05-11.31-.79-1.02-.92-1.9-2.59-1.52l-29.81,64.14-37.27,10.4-89.69,74.39c-.68,1.71,3.56,2.09,4.8,2.51,25.24,8.45,51.09,15.21,76.36,23.55l31.13,59.61ZM161.35,276.83h30.25c.46-9.17-13.93-6.86-18.8-12.82-1.17-2.41-.43-17.94,1.35-19.74l48.61-15.56,32.09-40.32,90.77-75.14-81.11-25.06-71.41,19.23c-13.53,14.59-22.84,35.52-37.23,48.92-10.52,9.79-25.05,21-37.89,27.19-17.95,8.64-37.11,15.51-55.63,22.76-.2,2.42-.09,1.51,1.4,1.79,9.04,1.68,18.83,2.01,27.94,3.7-3.37,8.55-8.59,16.31-12.56,24.56-.44.92-1.94,3.09-.74,3.84l42.17-24.74,41.7-49.48,10.12,46.23-21.68,26.59,10.66,38.06ZM442.53,171.19l22.26-73.06-31.58,16.54-28.47,94.34,37.78-37.82ZM445.54,276.83c-3.25-12.56-17.61-10.14-25.56-18.04l8.13-57.11-26.46,26.23-4.54,25.86c.68,1.08,13.16,4.78,15.19,6.8,2.38,2.38,5.27,12.64,6.66,16.25h26.59ZM240.65,276.83h32.54c-3.67-10.69-6.32-7.44-15.12-8.26-3.16-.29-6.44-1.11-9.63-1.37-.93-.54-10.67-17.49-10.86-18.54-.22-1.18-.1-1.9.24-3.02,1.52-4.99,22.76-13.02,28.08-18.71,1.93-2.07,9.88-14.96,10.88-17.55.61-1.59-.35-1.12-1.07-1.48-1.73-.86-16.42-5.48-17.65-5.33l-28,36.17-16.45,5.1,27.04,32.99ZM22.92,247.5h41.25l15.58-29.31-29.8-3.77-3.65,1.02-23.38,32.07Z"/><path d="M499.31,46.21c.8.77,5.3,8.4,4.9,8.84-10.59,3.03-19.84.32-24.78-9.58-.04-1.79,16.36-2.67,19.88.74Z"/></svg>
  </div>

  <div class="hero-tag">
    <div class="tag-pulse"></div>
    <span>Context Collective — Brest, Bretagne — Édition 01 — Mai 2026</span>
  </div>

  <div class="hero-title">
    <span class="l1">AI</span>
    <span class="l2">CREATION</span>
    <span class="l3">BATTLE</span>
  </div>

  <div class="hero-bottom">
    <p class="hero-desc">
      Une soirée live de 3 heures. Des profils totalement différents.
      <strong>1 heure pour construire un projet avec l'IA, en partant de zéro, avec le même budget de tokens pour tous.</strong>
    </p>
    <div class="hero-stats">
      <div class="hs"><div class="hs-val">3H</div><div class="hs-lbl">Soirée live</div></div>
      <div class="hs"><div class="hs-val">60'</div><div class="hs-lbl">Build chrono</div></div>
      <div class="hs"><div class="hs-val">10</div><div class="hs-lbl">Participants</div></div>
      <div class="hs"><div class="hs-val">01</div><div class="hs-lbl">1ère édition</div></div>
    </div>
  </div>

  <div class="scroll-hint">
    <div class="scroll-line"></div>
    <span>Scroll</span>
  </div>
</section>

<!-- MANIFESTE CONDENSÉ -->
<section class="manifeste-home">
  <div class="s-eyebrow reveal"><span>Pourquoi cet événement</span></div>
  <div class="s-title reveal rd1">L'IA ne se comprend pas<br/>en lisant des articles.</div>

  <p class="lead reveal rd2" style="margin-bottom:24px;">Elle se comprend en la voyant travailler. C'est pour ça qu'on organise la Battle : un événement live, sans filtre, où des gens de profils très différents construisent un projet réel en une heure.</p>

  <p class="reveal rd2" style="max-width:600px;margin-bottom:40px;">On ne cherche pas à impressionner. On cherche à rendre visible ce qui est <strong>déjà vrai.</strong></p>

  <a href="/la-battle" class="btn-ghost reveal rd3">Découvrir le format →</a>

  <div class="mh-entries reveal rd4">
    <a href="/participer" class="mh-entry">
      <span class="mhe-num">01</span>
      <span class="mhe-body">
        <strong>Vous avez une idée</strong>
        Développeur, designer, profil métier, curieux. Vous arrivez avec un projet. Vous repartez avec quelque chose qui existe.
      </span>
      <span class="mhe-arrow">→</span>
    </a>
    <a href="/nous-soutenir" class="mh-entry">
      <span class="mhe-num">02</span>
      <span class="mhe-body">
        <strong>Le projet vous parle</strong>
        Entreprise, collectivité, organisme. Si l'initiative vous intéresse, on est ouverts à la discussion.
      </span>
      <span class="mhe-arrow">→</span>
    </a>
    <a href="/edition-01" class="mh-entry">
      <span class="mhe-num">03</span>
      <span class="mhe-body">
        <strong>Mai 2026 — Brest</strong>
        French Tech Brest. Entrée libre pour les spectateurs. Première édition.
      </span>
      <span class="mhe-arrow">→</span>
    </a>
  </div>
</section>

<!-- CTA HOME -->
<section class="cta-home">
  <div class="ctah-inner reveal">
    <div class="s-title" style="text-align:center;margin-bottom:48px;">Est-ce qu'on regarde,<br/><span class="yel">ou est-ce qu'on s'y met ?</span></div>
    <div class="ctah-actions">
      <a href="/participer" class="btn-main">Je veux participer →</a>
      <span class="or-sep">ou</span>
      <a href="/nous-soutenir" class="btn-ghost">Soutenir le projet</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* HERO */
.hero {
  min-height: 100vh;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 var(--pad-x) 80px;
  position: relative;
  overflow: hidden;
  border-top: none;
}
.hero-bg {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  pointer-events: none; overflow: hidden;
}
.hero-bg span {
  font-family: var(--font-display);
  font-size: 38vw;
  color: transparent;
  -webkit-text-stroke: 1px #151515;
  white-space: nowrap;
  letter-spacing: -0.02em;
  animation: breathe 8s ease-in-out infinite;
  user-select: none;
}
@keyframes breathe {
  0%,100% { transform: scale(1); opacity:0.7; }
  50% { transform: scale(1.015); opacity:1; }
}
.hero-logo {
  position: absolute;
  left: var(--pad-x);
  top: 120px;
  width: clamp(60px, 6vw, 90px);
  color: var(--yellow);
  pointer-events: none;
  user-select: none;
  opacity: 0;
  animation: logofade 1.4s 0.4s forwards;
}
@keyframes logofade {
  from { opacity: 0; transform: scale(0.9); }
  to   { opacity: 0.15; transform: scale(1); }
}
.hero-hermine {
  position: absolute;
  right: var(--pad-x);
  top: 50%;
  transform: translateY(-50%);
  width: clamp(300px, 36vw, 580px);
  color: var(--yellow);
  pointer-events: none;
  user-select: none;
  opacity: 0;
  animation: herminefade 1.6s 0.6s forwards, herminepulse 6s 2.2s ease-in-out infinite;
}
@keyframes herminefade {
  from { opacity: 0; transform: translateY(-50%) scale(0.95); }
  to   { opacity: 0.05; transform: translateY(-50%) scale(1); }
}
@keyframes herminepulse {
  0%,100% { opacity: 0.05; }
  50% { opacity: 0.09; }
}

.hero-tag {
  display: flex; align-items: center; gap: 14px;
  margin-bottom: 36px;
  opacity: 0; animation: fadeup 0.9s 0.1s forwards;
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  letter-spacing: 0.2em;
  color: var(--yellow);
  text-transform: uppercase;
}
.tag-pulse {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--yellow);
  animation: blink 1.8s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(80px, 13vw, 180px);
  line-height: 0.86;
  margin-bottom: 48px;
  opacity: 0; animation: fadeup 0.9s 0.25s forwards;
}
.hero-title .l1 { display: block; color: var(--text-1); }
.hero-title .l2 { display: block; color: var(--yellow); }
.hero-title .l3 { display: block; -webkit-text-stroke: 2px var(--white); color: transparent; }

.hero-bottom {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: end;
  opacity: 0; animation: fadeup 0.9s 0.45s forwards;
}
.hero-desc {
  max-width: 460px;
}

.hero-stats {
  display: flex; gap: 40px; justify-content: flex-end;
}
.hs { text-align: center; }
.hs-val {
  font-family: var(--font-display);
  font-size: 48px;
  color: var(--yellow);
  line-height: 1;
}
.hs-lbl {
  font-family: var(--font-mono);
  font-size: var(--text-mono-sm);
  color: var(--text-3);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-top: 8px;
}

.scroll-hint {
  position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 10px;
  opacity: 0; animation: fadeup 0.9s 1.1s forwards;
  font-family: var(--font-mono);
  font-size: 9px; color: var(--text-3);
  letter-spacing: 0.18em; text-transform: uppercase;
}
.scroll-line {
  width: 1px; height: 44px;
  background: linear-gradient(to bottom, var(--yellow), transparent);
  animation: drip 1.8s ease-in-out infinite;
}
@keyframes drip {
  0%{ transform:scaleY(0); transform-origin:top; }
  50%{ transform:scaleY(1); transform-origin:top; }
  51%{ transform:scaleY(1); transform-origin:bottom; }
  100%{ transform:scaleY(0); transform-origin:bottom; }
}
@keyframes fadeup {
  from { opacity:0; transform:translateY(24px); }
  to   { opacity:1; transform:translateY(0); }
}

/* MANIFESTE HOME */
.manifeste-home { background: var(--dark); }

.mh-entries {
  display: flex; flex-direction: column;
  margin-top: 72px;
}
.mh-entry {
  display: grid;
  grid-template-columns: 56px 1fr 32px;
  gap: 24px;
  align-items: center;
  padding: 32px 0;
  border-top: 1px solid var(--border2);
  transition: padding-left 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}
.mh-entry:last-child { border-bottom: 1px solid var(--border2); }
.mh-entry:hover { padding-left: 12px; }
.mhe-num {
  font-family: var(--font-display);
  font-size: 40px;
  color: var(--border2);
  line-height: 1;
  transition: color 0.3s;
}
.mh-entry:hover .mhe-num { color: var(--yellow); }
.mhe-body { display: flex; flex-direction: column; gap: 4px; }
.mhe-body strong {
  font-size: var(--text-body);
  font-weight: 600;
  letter-spacing: 0.02em;
}
.mhe-arrow {
  font-family: var(--font-mono);
  font-size: 16px;
  color: var(--border2);
  justify-self: end;
  transition: color 0.3s, transform 0.3s;
}
.mh-entry:hover .mhe-arrow { color: var(--yellow); transform: translateX(4px); }

/* CTA HOME */
.cta-home {
  background: var(--black);
  padding: 160px var(--pad-x);
  text-align: center;
}
.ctah-actions {
  display: flex; align-items: center; justify-content: center;
  gap: 20px; flex-wrap: wrap;
}

@media (max-width: 768px) {
  .hero-logo { display: none; }
  .hero-hermine { display: none; }
  .hero { padding: 0 24px 64px !important; }
  .hero-title { font-size: clamp(56px, 16vw, 120px); }
  .hero-bottom { grid-template-columns: 1fr; gap: 32px; }
  .hero-stats { justify-content: flex-start; gap: 28px; flex-wrap: wrap; }
  .mh-entry { grid-template-columns: 44px 1fr 24px; gap: 16px; padding: 24px 0; }
  .mhe-num { font-size: 32px; }
  .cta-home { padding: 80px 24px !important; }
  .ctah-actions { flex-direction: column; align-items: stretch; }
  .btn-main, .btn-ghost { justify-content: center; }
}
</style>
